// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Teacher {
  id         Int    @id @default(autoincrement())
  name       String
  last_name  String
  email      String @unique
  dni        String @unique
  commission Int

  @@map("teachers")
}


model Patient {
  id         Int    @id @default(autoincrement())
  name       String
  last_name  String
  email      String @unique
  dni        String @unique
  commission Int

  @@map("patients")
}