# Clave Base64 de 32 bytes (256 bits). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Duración del token de acceso y del refresh token.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie httpOnly que almacena el refresh token en clientes web.
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_PATH=/api/v1/auth
# lax | strict | none. Con "none" se exige HTTPS y COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
# true en producción (HTTPS). Por defecto se deriva de COOKIE_SAME_SITE.
COOKIE_SECURE=false
# Opcional: dominio de la cookie (por ejemplo .rehabhur.com).
COOKIE_DOMAIN=

# Orígenes permitidos para CORS con credenciales, separados por coma.
# En producción definir el dominio real del frontend.
CORS_ORIGIN=http://localhost:5173
